{
  "name": "kysely-postgres-js",
  "version": "5.0.2",
  "description": "Kysely dialect for PostgreSQL using the Postgres.js client",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kysely-org/kysely-postgres-js.git"
  },
  "homepage": "https://kysely.dev",
  "author": "Igal Klebanov <igalklebanov@gmail.com> (https://github.com/igalklebanov)",
  "license": "MIT",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kysely",
    "postgres",
    "postgres.js",
    "postgresql",
    "dialect",
    "query builder",
    "query",
    "sql",
    "typescript",
    "type-safe",
    "type-safety",
    "bun",
    "node"
  ],
  "scripts": {
    "biome": "biome",
    "build": "tsdown",
    "check:types": "tsc --noEmit",
    "lint:deno": "deno lint --config=\"deno.lint.json\" ./src",
    "prepublishOnly": "biome check && pnpm build",
    "script:align-versions": "node --experimental-strip-types scripts/align-versions.ts",
    "test": "pnpm test:node --run && pnpm test:bun --run",
    "test:bun": "bun --bun vitest",
    "test:node": "vitest",
    "version": "pnpm script:align-versions && biome format --write && git add ."
  },
  "peerDependencies": {
    "kysely": ">= 0.29.0 < 1",
    "postgres": ">= 3.4.0 < 5"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.6.5",
    "@tsconfig/node24": "24.0.5",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "jsr": "0.14.3",
    "kysely": "0.29.8",
    "postgres": "3.4.9",
    "publint": "0.3.25",
    "std-env": "4.3.0",
    "tsdown": "0.23.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "sideEffects": false,
  "engines": {
    "bun": ">=1.2",
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}

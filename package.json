{
  "name": "kysely-postgres-js",
  "version": "5.0.0",
  "description": "Kysely dialect for PostgreSQL using the Postgres.js client",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kysely-org/kysely-postgres-js.git"
  },
  "homepage": "https://kysely.dev",
  "author": "Igal Klebanov <igalklebanov@gmail.com> (https://github.com/igalklebanov)",
  "license": "MIT",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kysely",
    "postgres",
    "postgres.js",
    "postgresql",
    "dialect",
    "query builder",
    "query",
    "sql",
    "typescript",
    "type-safe",
    "type-safety",
    "bun",
    "node"
  ],
  "scripts": {
    "biome": "biome",
    "build": "tsdown",
    "check:types": "tsc --noEmit",
    "lint:deno": "deno lint --config=\"deno.lint.json\" ./src",
    "prepublishOnly": "biome check && pnpm build",
    "script:align-versions": "node --experimental-strip-types scripts/align-versions.ts",
    "test": "pnpm test:node --run && pnpm test:bun --run",
    "test:bun": "bun --bun vitest",
    "test:node": "vitest",
    "version": "pnpm script:align-versions && biome format --write && git add ."
  },
  "peerDependencies": {
    "kysely": ">= 0.29.0 < 1",
    "postgres": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@tsconfig/node24": "24.0.5",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "jsr": "0.14.3",
    "kysely": "0.29.6",
    "postgres": "3.4.9",
    "publint": "0.3.24",
    "std-env": "4.2.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "sideEffects": false,
  "engines": {
    "bun": ">=1.2",
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
